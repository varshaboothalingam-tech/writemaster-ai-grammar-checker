# Copy to .env and fill in. NEVER commit .env.

# ── Gemini (cloud AI, best quality) ────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Local open-source AI via Ollama (free, unlimited, runs on THIS machine) ─
# Install: https://ollama.com  →  then pull a model, e.g.:
#   ollama pull llama3.2:3b
# No key needed. Ollama is auto-detected on http://localhost:11434 when no
# provider/key is configured, so it works with zero setup.
OLLAMA_MODEL=llama3.2:3b

# ── Extra cloud providers (optional) ───────────────────────────────────────
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ── Provider selection ──────────────────────────────────────────────────────
# AI_PROVIDER: single provider (ollama | gemini | groq | openai | anthropic |
# openrouter | none). Set "none" to force the offline rule checker.
# AI_PROVIDER=gemini

# GC_AI_PROVIDERS: comma-separated ensemble = ALL the AIs the checker may use.
# It calls the first provider that is reachable and falls back to the next on
# failure (e.g. Ollama first locally, Gemini in the cloud). Example:
# GC_AI_PROVIDERS=ollama,gemini,groq,openrouter

# ── Tuning ──────────────────────────────────────────────────────────────────
# GC_AI_THRESHOLD   minimum AI confidence to accept a fix (default 0.90)
# GC_AI_MIN_APPROVALS number of providers that must agree in ensemble mode
# GC_MAX_PASSES     re-check the corrected text up to N times (default 1, max 3)
# AI_BASE_URL       Ollama/OpenAI-compatible endpoint (default http://localhost:11434)